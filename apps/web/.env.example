# ── Production deployment ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.yourapp.com
NEXT_PUBLIC_API_KEY=your-production-api-key

# ── Sandbox deployment (demo.yourapp.com) ─────────────────────────────────────
# Point these at a separate API instance backed by its own test chain.
# If NEXT_PUBLIC_SANDBOX_API_URL is omitted, the sandbox page falls back
# to NEXT_PUBLIC_API_URL — safe for local dev, not recommended for production.
NEXT_PUBLIC_SANDBOX_API_URL=https://sandbox-api.yourapp.com
NEXT_PUBLIC_SANDBOX_API_KEY=your-sandbox-api-key
